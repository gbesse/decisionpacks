{
  "name": "@gbesse/decisionpacks",
  "version": "0.2.2",
  "description": "Portable, versioned decision contracts for Jev with validated answers and policy replay.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "decisionpacks": "./bin/decisionpacks.mjs"
  },
  "files": [
    "src",
    "bin",
    "packs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "demo": "node examples/demo.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/decisionpacks.git"
  },
  "bugs": {
    "url": "https://github.com/gbesse/decisionpacks/issues"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
